CONFIG_IDF_TARGET="esp32s3"

# Memoria flash: DevKitC-1 N16R8
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: se încearcă octal (modulele R8); pornește și fără, dacă modulul nu are,
# ca ecranul de punere în funcțiune să arate ce avem de fapt.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Tic de 1 ms pentru timpi de așteptare mai fini și citirea butoanelor. Interfața
# rulează în taskul principal: 16 KB de stivă (ecranul de diagnostic arată cât rămâne).
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# FAT pe cardul SD: nume lungi de fișiere, nume UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Discul USB (FW-12): cardul ca stick pe portul USB nativ. Consola rămâne pe
# UART0 (portul „UART” al plăcii de dezvoltare). Tamponul de 4 KB lasă TinyUSB
# să scrie 8 sectoare deodată pe card, nu câte unul.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="USV Suceava"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Cititor e-ink"
CONFIG_TINYUSB_DESC_MSC_STRING="Cititor e-ink"

# Somnul ușor automat (FW-7): taskul IDLE oprește procesoarele între apăsări și
# cât lucrează panoul. Ieșirea din somn chemă un contor (ecranul de diagnostic,
# evenimentul light_sleep din jurnalul de măsurători).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# ESP-IDF deconectează în somnul ușor toți pinii (CONFIG_PM_SLP_DISABLE_GPIO,
# cerut de ocolirea resetului din ESD). Liniile care trebuie să-și țină starea
# (cardul, panoul, comutatoarele șinelor) le scoate board_light_sleep_pins().
