diff --git a/hw/timer/esp_systimer.c b/hw/timer/esp_systimer.c
index 11b2db5..11f335d 100644
--- a/hw/timer/esp_systimer.c
+++ b/hw/timer/esp_systimer.c
@@ -601,9 +601,39 @@ static void esp_systimer_default_conf(ESPSysTimerState *s)
 }
 
 
+void esp_systimer_freeze(ESPSysTimerState *s, bool frozen)
+{
+    if (s->frozen == frozen) {
+        return;
+    }
+    for (int i = 0; i < ESP_SYSTIMER_COUNTER_COUNT; i++) {
+        ESPSysTimerCounter *counter = &s->counter[i];
+
+        if (frozen) {
+            if (counter->enabled) {
+                esp_systimer_update_counter(counter);
+            }
+            s->frozen_enabled[i] = counter->enabled;
+            counter->enabled = false;
+        } else {
+            counter->base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            counter->enabled = s->frozen_enabled[i];
+        }
+    }
+    s->frozen = frozen;
+    /* Alarmele contoarelor oprite nu mai vin; la pornire se programează din nou. */
+    for (int i = 0; i < ESP_SYSTIMER_COMP_COUNT; i++) {
+        if (s->comparators[i].enabled) {
+            esp_systimer_comparator_reprogram(&s->comparators[i]);
+        }
+    }
+}
+
+
